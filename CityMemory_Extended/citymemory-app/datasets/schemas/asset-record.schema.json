{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CityMemory Asset Record",
  "type": "object",
  "required": [
    "id",
    "type",
    "name",
    "lat",
    "lng",
    "complaints",
    "repairs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable asset identifier; do not reuse IDs."
    },
    "type": {
      "type": "string",
      "enum": [
        "road",
        "drain",
        "streetlight",
        "footpath",
        "toilet"
      ]
    },
    "name": {
      "type": "string"
    },
    "lat": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "lng": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "department": {
      "type": "string"
    },
    "footfall": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "complaints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "text"
        ],
        "properties": {
          "date": {
            "type": [
              "number",
              "string"
            ]
          },
          "text": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "department": {
            "type": "string"
          },
          "photoData": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "repairs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": [
              "number",
              "string"
            ]
          },
          "action": {
            "type": "string"
          },
          "cost": {
            "type": "number"
          },
          "department": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "inspections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": [
              "number",
              "string"
            ]
          },
          "findings": {
            "type": "string"
          },
          "condition": {
            "type": "string"
          },
          "department": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}